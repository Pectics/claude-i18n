{
  "buildCommand": "bash ./build.sh",
  "ignoreCommand": "bash ./ignore.sh",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/badges/:locale.svg",
      "destination": "https://pectics.github.io/claude-i18n/badges/:locale.svg"
    },
    {
      "source": "/coverage.json",
      "destination": "https://pectics.github.io/claude-i18n/coverage.json"
    },
    {
      "source": "/version/:locale.json",
      "destination": "/:locale/version.json"
    },
    {
      "source": "/i18n/:locale.json",
      "destination": "/:locale/:locale.json"
    },
    {
      "source": "/i18n/dynamic/:locale.json",
      "destination": "/:locale/:locale.dynamic.json"
    }
  ]
}
