{
  "buildCommand": "bash ./build.sh",
  "ignoreCommand": "bash ./ignore.sh",
  "outputDirectory": "dist",
  "functions": {
    "api/coverage.js": {
      "includeFiles": "locales.json"
    }
  },
  "rewrites": [
    {
      "source": "/version/:locale.json",
      "destination": "/:locale/version.json"
    },
    {
      "source": "/i18n/:locale.json",
      "destination": "/:locale/:locale.json"
    },
    {
      "source": "/i18n/dynamic/:locale.json",
      "destination": "/:locale/:locale.dynamic.json"
    }
  ]
}
